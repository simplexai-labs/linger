# Every fixed setting for running the services on this computer with `pnpm dev`.
# scripts/with-local-env.mjs and the root docker-compose.yml load this file
# first. The ignored root .env holds personal values and overrides any name set
# here; Compose sets its container listeners and paths explicitly. Deployments
# set their own environment.

# PostgreSQL 17 with pgvector that you run for `pnpm dev`. The default matches
# the postgres service of the root docker-compose.yml; point it at your own.
TEAMHUB_DATABASE_URL=postgres://simplexai:simplexai@localhost:5432/simplexai_dev?sslmode=disable
# Web origin used by the browser, the Local Computer installer and TeamHub links.
WEB_PUBLIC_ORIGIN=http://localhost:3000
# Development seed for every service credential. Not for production.
LINGER_SECRET_SEED=local-development-secret-seed-not-for-production
# Encrypts the Composio key saved in Connectors, so Connect can ask for it.
# For `pnpm dev` only; production generates its own (openssl rand -base64 32).
TEAMHUB_SECRET_ENCRYPTION_KEY=iKtGNQf7Faous8Jl1FN9TBuJPyeLcA7Cml4Kf0ZDaJE=

# The Vite dev proxy forwards X-Forwarded-For from loopback; TeamHub trusts it
# there only, so failed logins count per browser rather than per dev server.
TEAMHUB_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Agent state under the checkout; Node Services resolves a relative path from
# the repository root, wherever it starts.
AGENT_HOME=.linger-runtime/agent
# The Computer release `make computer-release-local` builds, served on /install/.
COMPUTER_RELEASE_DIR=.linger-runtime/computer-release
# The Runner Gateway that a Local Computer on this machine connects to, over
# plaintext. The Computer gets its credential by enrolling, as in production.
AGENT_RUNNER_PUBLIC_GATEWAY_URL=ws://127.0.0.1:4319/v1/runner-gateway
