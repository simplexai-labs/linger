diff --git a/dist/worker.cjs b/dist/worker.cjs
index 825526b2dfc3e91efc74b166a5f1c043d7a0ead6..748668b0c2a36ff7de85dc0f4c4b4224bdc4298e 100644
--- a/dist/worker.cjs
+++ b/dist/worker.cjs
@@ -54,6 +54,12 @@ const MAX_RECONNECT_ATTEMPTS = 10;
 const ASSIGNMENT_TIMEOUT = 7.5 * 1e3;
 const UPDATE_LOAD_INTERVAL = 2.5 * 1e3;
 const DRAIN_TIMEOUT = 60 * 60 * 1e3;
+// LiveKit keeps a worker registered while it can no longer write to it, and
+// every job assignment then fails. Its WebSocket answers pings, so pongs that
+// stop arriving reveal such a connection; terminating it lets the reconnect
+// loop register a working one.
+const HEARTBEAT_INTERVAL = 10 * 1e3;
+const HEARTBEAT_MISSED_PONGS = 3;
 const PROJECT_TYPE = "nodejs";
 const WORKER_PROTOCOL_VERSION = 1;
 let localEotRunnerRegistered = false;
@@ -281,7 +287,6 @@ class AgentServer {
         opts.loadThreshold = loadThreshold;
       }
     }
-    maybeRegisterLocalEotRunner();
     this.#inferenceExecutor = import_inference_proc_executor.InferenceProcExecutor.createIfNeeded();
     this.#procPool = new import_proc_pool.ProcPool(
       opts.agent,
@@ -651,9 +656,28 @@ class AgentServer {
         this.#logger.warn({ error: e }, "failed to measure CPU load");
       });
     }, UPDATE_LOAD_INTERVAL);
+    let unansweredPings = 0;
+    ws.on("pong", () => {
+      unansweredPings = 0;
+    });
+    const heartbeat = setInterval(() => {
+      if (unansweredPings >= HEARTBEAT_MISSED_PONGS) {
+        clearInterval(heartbeat);
+        this.#logger.warn(
+          { unansweredPings },
+          "worker connection stopped answering pings, reconnecting"
+        );
+        ws.terminate();
+        return;
+      }
+      if (ws.readyState !== import_ws.WebSocket.OPEN) return;
+      unansweredPings++;
+      ws.ping();
+    }, HEARTBEAT_INTERVAL);
     try {
       await close;
     } finally {
+      clearInterval(heartbeat);
       ws.removeAllListeners();
     }
   }
