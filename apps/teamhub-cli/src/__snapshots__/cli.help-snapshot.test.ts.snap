-Za-z0-9_-]*$","description":"Stable TeamHub Actor identifier referenced by this segment."},"target_type":{"type":"string","enum":["agent","user"],"description":"Declared Actor kind; TeamHub verifies it against the target."}},"required":["type","content","target","target_type"],"additionalProperties":false,"description":"Actor-reference segment. Include type:\\"reference\\", content, target, and target_type; for example {\\"type\\":\\"reference\\",\\"content\\":\\"@Analyst\\",\\"target\\":\\"actor_analyst\\",\\"target_type\\":\\"agent\\"}."}],"description":"One text or Actor-reference segment of the initial message."},"description":"Ordered structured segments of the initial message created after approval."}},"required":["name","member_ids","initial_message_segments"],"additionalProperties":false,"description":"Arguments accepted by the create_room tool."},"output_schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"accepted":{"type":"boolean","const":true,"description":"Whether TeamHub accepted the Creation request."},"status":{"type":"string","const":"pending_approval","description":"Current state of the Creation request."},"creation_approval_request_id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]*$","description":"Stable identifier of the Creation approval request."},"message_id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]*$","description":"Stable identifier of the Human approval card message."}},"required":["accepted","status","creation_approval_request_id","message_id"],"additionalProperties":false,"description":"Successful result returned by the create_room tool."},"cli":{"usage":["teamhub room create [flags]"],"arguments":[],"options":{"--name":{"description":"Proposed Room name."},"--description":{"description":"Optional description."},"--member-id":{"description":"Explicit member Actor ID; repeat for each member.","repeatable":true},"--member-ids":{"description":"Explicit member Actor ID array as JSON."},"--content":{"description":"Inline Markdown body; outside code, \\\\n, \\\\t and \\\\\\\\ are decoded."},"--file":{"description":"Read UTF-8 body from a file or - for stdin."},"--initial-message-segments":{"description":"Initial text/reference segments as a JSON array."},"--initial-message-segments-file":{"description":"Read initial-message-segments JSON from a file or - for stdin."},"--artifact-id":{"description":"Authorized existing Document ID; repeat up to five times.","repeatable":true},"--artifacts":{"description":"Authorized Document IDs as a JSON array."},"--json":{"description":"Return machine-readable JSON.","boolean":true},"--help":{"description":"Show this offline command reference.","boolean":true},"-h":{"description":"Show help.","boolean":true},"--schema":{"description":"Show offline input and output schemas.","boolean":true},"--operation-id":{"description":"Stable operation identity for recovery."}},"notes":[]}}
