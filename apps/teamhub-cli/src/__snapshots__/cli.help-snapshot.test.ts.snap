se,"properties":{"connectionId":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"displayName":{"type":"string"},"identityLabel":{"type":"string"}},"required":["connectionId","name","displayName","identityLabel"]},"jobs":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"jobId":{"type":"string","minLength":1},"type":{"type":"string"},"model":{"type":"string"},"status":{"enum":["queued","running","completed","failed"]},"error":{"type":"string"},"url":{"type":"string"},"thumbnailUrl":{"type":"string"}},"required":["jobId","status"]}},"rejected":{"type":"object","additionalProperties":false,"properties":{"error":{"type":"string"},"reason":{"type":"string"},"recoveryTool":{"type":"string"}},"required":[]},"unlimitedChoice":{},"inputs":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"source":{"type":"string","minLength":1},"mediaId":{"type":"string","minLength":1}},"required":["source","mediaId"]}},"adjustments":{"type":"object","additionalProperties":true},"warning":{"type":"string"},"files":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"url":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"sizeBytes":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"warning":{"type":"string"}},"required":["url","path","sizeBytes","sha256"]}},"nextCommand":{"type":"string"}},"required":["account","jobs"]}]},{"type":"object","additionalProperties":false,"properties":{"account":{"type":"object","additionalProperties":false,"properties":{"connectionId":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"displayName":{"type":"string"},"identityLabel":{"type":"string"}},"required":["connectionId","name","displayName","identityLabel"]},"result":{"type":"object","additionalProperties":false,"properties":{"action":{"const":"confirmation_requested"},"confirmation":{"type":"object","additionalProperties":false,"properties":{"status":{"const":"pending"},"interactionId":{"type":"string","minLength":1},"messageId":{"type":"string","minLength":1},"roomId":{"type":"string","minLength":1}},"required":["status","interactionId","messageId","roomId"]}},"required":["action","confirmation"]}},"required":["account","result"]}]},"cli":{"usage":["teamhub video-gen --provider <provider> --model <model-id> --prompt <text> [flags]","teamhub video-gen --provider <provider> --price [--model <model-id>] [flags]","teamhub video-gen --provider <provider> --model <model-id> --job <job-id> [flags]"],"arguments":[],"options":{"--provider":{"description":"fal or higgsfield; required."},"--model":{"description":"Provider model ID; required for generation and job lookup."},"--prompt":{"description":"What to generate; required for generation."},"--price":{"description":"Read model prices without starting a job; --model selects one model and its parameters.","boolean":true},"--job":{"description":"Check an existing job once without submitting again; repeatable for Higgsfield.","repeatable":true},"--set":{"description":"Model parameter as field=value; repeatable. JSON values keep their types.","repeatable":true},"--file":{"description":"Reference input as field=local-path; repeatable. Use a fal input field or a Higgsfield media role.","repeatable":true},"--output":{"description":"Where finished results are saved: one to a new file, several to a new directory. Saved by the --job check that finds the job finished; never overwrites."},"--limit":{"description":"Price-list page size, 1-100, default 20."},"--cursor":{"description":"Continue the previous price-list page with the same provider and account."},"--account":{"description":"Select a connection ID or complete account label; when authorization is missing, an authorization card is shown in the chat."},"--json":{"description":"Return machine-readable JSON.","boolean":true},"--help":{"description":"Show this offline command reference