":["teamhub room members [flags]"],"arguments":[],"options":{"--thread":{"description":"Use this Thread ID inside the configured Room."},"--json":{"description":"Return machine-readable JSON.","boolean":true},"--help":{"description":"Show this offline command reference.","boolean":true},"-h":{"description":"Show help.","boolean":true},"--schema":{"description":"Show offline input and output schemas.","boolean":true}},"notes":[]}}
