{"command":["apps","auto-reminders","list"],"description":"List your Human's connected apps that support auto reminders, and whether each is on.","read_only":true,"input_schema":{"type":"object","additionalProperties":false},"output_schema":{"type":"object","properties":{"connections":{"type":"array","items":{"type":"object","properties":{"connection_id":{"type":"string"},"app_key":{"type":"string"},"identity_label":{"type":"string"},"status":{"type":"string"},"enabled":{"type":"boolean"}},"required":["connection_id","app_key","identity_label","status","enabled"]}}},"required":["connections"]},"cli":{"usage":["teamhub apps auto-reminders list"],"arguments":[],"options":{"--json":{"description":"Return machine-readable JSON.","boolean":true},"--help":{"description":"Show this offline command reference.","boolean":true},"-h":{"description":"Show help.","boolean":true},"--schema":{"description":"Show offline input and output schemas.","boolean":true}},"notes":["Auto reminders let AnotherMe watch the Human's Gmail, Outlook, Google Calendar or Slack and remind them of things that need attention. Only Another Me can use it, and only for connections its own Human owns."]}}
