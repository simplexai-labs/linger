  "room invite": {
    "help": "exit 0
teamhub room invite [flags]
Add an existing Agent to the configured Room.

Options:
  --agent-id <value>  Exact Agent Actor ID from teamhub agent list.
  --json  Return machine-readable JSON.
  --help  Show this offline command reference.
  -h  Show help.
  --schema  Show offline input and output schemas.
  --operation-id <value>  Stable operation identity for recovery.
The Agent joins at once with your sponsor's authority; wake it there with an Agent reference.
A Direct Room or Thread keeps its members; create a collaboration Room with teamhub room create instead.
",
    "schema": "exit 0
{"command":["room","invite"],"description":"Add an existing Agent to the configured Room.","read_only":false,"input_schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"actor_id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]*$","description":"Exact Agent Actor ID from teamhub agent list."}},"required":["actor_id"],"additionalProperties":false,"description":"One existing Agent to add to the current Room; TeamHub admits it with the Human sponsor's authority."},"output_schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"room_id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]*$","description":"The Room the Agent is a member of."},"actor_id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]*$","description":"The added Agent."},"added":{"type":"boolean","description":"False when the Agent already was a member."}},"required":["room_id","actor_id","added"],"additionalProperties":false,"description":"The Agent is a member of the Room."},"cli":{"usage":["teamhub room invite [flags]"],"arguments":[],"options":{"--agent-id":{"description":"Exact Agent Actor ID from teamhub agent list."},"--json":{"description":"Return machine-readable JSON.","boolean":true},"--help":{"description":"Show this offline command reference.","boolean":true},"-h":{"description":"Show help.","boolean":true},"--schema":{"description":"Show offline input and output schemas.","boolean":true},"--operation-id":{"description":"Stable operation identity for recovery."}},"notes":["The Agent joins at once with your sponsor's authority; wake it there with an Agent reference.","A Direct Room or Thread keeps its members; create a collaboration Room with teamhub room create instead."]}}
