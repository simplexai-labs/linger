  "routine create": {
    "help": "exit 0
teamhub routine create [flags]
Create a Routine in the configured Room.

Options:
  --name <value>  Routine name.
  --content <value>  Inline Markdown body; outside code, \\n, \\t and \\\\ are decoded.
  --file <value>  Read UTF-8 body from a file or - for stdin.
  --mention-actor-id <value>  Current Room Agent Actor ID, or self.
  --schedule <value>  Complete daily, weekly, every_n_hours or once schedule JSON.
  --schedule-file <value>  Read schedule JSON from a file or - for stdin.
  --daily <value>  Daily local time as HH:MM.
  --weekly <value>  Weekly local time as HH:MM.
  --weekday <value>  Selected weekday; repeat unique days.
  --timezone <value>  Explicit IANA timezone for daily or weekly.
  --every-hours <value>  Repeat every 1-168 hours.
  --at <value>  Fire once at this RFC 3339 time (with offset); done afterwards.
  --tracking-item <value>  Tracking Item ID this Routine serves; requires --purpose.
  --purpose <value>  What this Routine checks or reminds for its Tracking Item.
  --json  Return machine-readable JSON.
  --help  Show this offline command reference.
  -h  Show help.
  --schema  Show offline input and output schemas.
  --operation-id <value>  Stable operation identity for recovery.
",
    "schema": "exit 0
{"command":["routine","create"],"description":"Create a Routine in the configured Room.","read_only":false,"input_schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":120,"description":"Short name shown in the room Routine list."},"instruction":{"type":"string","minLength":1,"maxLength":50000,"description":"The message posted in this room when the Routine fires."},"schedule":{"oneOf":[{"type":"object","properties":{"kind":{"type":"string","const":"daily","description":"Post once every day."},"time":{"type":"string","pattern":"^(?:[01]\\\\d|2[0-3]):[0-5]\\\\d$","description":"Local 24-hour time as HH:MM, for example 09:00."},"timezone":{"type":"string","minLength":1,"maxLength":255,"description":"IANA timezone for the clock time, such as America/New_York. Use the timezone the user stated."}},"required":["kind","time","timezone"],"additionalProperties":false,"description":"Post once a day at a local clock time."},{"type":"object","properties":{"kind":{"type":"string","const":"weekly","description":"Post on selected weekdays each week."},"weekdays":{"minItems":1,"maxItems":7,"type":"array","items":{"type":"string","enum":["monday","tuesday","wednesday","thursday","friday","saturday","sunday"],"description":"One selected local weekday."},"uniqueItems":true,"description":"Selected local weekdays. Use one Routine for multiple days at the same time, e.g. Monday through Friday."},"time":{"type":"string","pattern":"^(?:[01]\\\\d|2[0-3]):[0-5]\\\\d$","description":"Local 24-hour time as HH:MM, for example 09:00."},"timezone":{"type":"string","minLength":1,"maxLength":255,"description":"IANA timezone for the clock time, such as America/New_York. Use the timezone the user stated."}},"required":["kind","weekdays","time","timezone"],"additionalProperties":false,"description":"Post on one or more selected weekdays at the same local clock time."},{"type":"object","properties":{"kind":{"type":"string","const":"every_n_hours","description":"Repeat a fixed number of hours after the previous post."},"interval_hours":{"type":"integer","minimum":1,"maximum":168,"description":"How many hours between posts, from 1 to 168."}},"required":["kind","interval_hours"],"additionalProperties":false,"description":"Repeat every N hours, starting from now."},{"type":"object","properties":{"kind":{"type":"string","const":"once","description":"Post a single time, then stop."},"run_at":{"type":"string","format":"date-time","pattern":"^(?:(?:\\\\d\\\\d[2468][048]|\\\\d\\\\d[13579][26]|\\\\d\\\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\\\d|30)|(?:02)-(?:0[1-9]|1\\\\d|2[0-8])))T(?:(?:[01]\\\\d|2[0-3]):[0-5]\\\\d(?::[0-5]\\\\d(?:\\\\.\\\\d+)?)?(?:Z|([+-](?:[01]\\\\d|2[0-3]):[0-5]\\\\d)))$","description":"The future moment to post, RFC 3339 with offset, for example 2026-10-22T14:30:00-04:00."},"timezone":{"type":"string","minLength":1,"maxLength":255,"description":"IANA timezone for the clock time, such as America/New_York. Use the timezone the user stated."}},"required":["kind","run_at"],"additionalProperties":false,"description":"Post once at a set time, for example a check before a meeting; the Routine is done afterwards."}],"description":"When the Routine posts. daily and weekly use a clock time and timezone. every_n_hours repeats from now. once posts a single time at run_at."},"mention_actor_id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]*$","description":"Omit to post plain text. Use \\"self\\" to wake yourself. Otherwise pass the actor id of an Agent still in this room."},"tracking_item_id":{"description":"Tracking Item of your Human this Routine serves; deleting the item deletes the Routine.","type":"string","pattern":"^ti_[a-f0-9]{32}$"},"tracking_purpose":{"description":"What this Routine checks or reminds for its Tracking Item.","type":"string","minLength":1,"maxLength":500}},"required":["name","instruction","schedule"],"additionalProperties":false,"description":"Name, message, schedule, and optional mention for a new Routine."},"output_schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]*$","description":"Stable Routine id."},"name":{"type":"string","minLength":1,"maxLength":120,"description":"Routine name."},"instruction":{"type":"string","minLength":1,"maxLength":50000,"description":"Message posted when the Routine fires."},"mention_actor_id":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]*$","description":"Omit to post plain text. Use \\"self\\" to wake yourself. Otherwise pass the actor id of an Agent still in this room."},"schedule":{"oneOf":[{"type":"object","properties":{"kind":{"type":"string","const":"daily","description":"Post once every day."},"time":{"type":"string","pattern":"^(?:[01]\\\\d|2[0-3]):[0-5]\\\\d$","description":"Local 24-hour time as HH:MM, for example 09:00."},"timezone":{"type":"string","minLength":1,"maxLength":255,"description":"IANA timezone for the clock time, such as America/New_York. Use the timezone the user stated."}},"required":["kind","time","timezone"],"additionalProperties":false,"description":"Post once a day at a local clock time."},{"type":"object","properties":{"kind":{"type":"string","const":"weekly","description":"Post on selected weekdays each week."},"weekdays":{"minItems":1,"maxItems":7,"type":"array","items":{"type":"string","enum":["monday","tuesday","wednesday","thursday","friday","saturday","sunday"],"description":"One selected local weekday."},"uniqueItems":true,"description":"Selected local weekdays. Use one Routine for multiple days at the same time, e.g. Monday through Friday."},"time":{"type":"string","pattern":"^(?:[01]\\\\d|2[0-3]):[0-5]\\\\d$","description":"Local 24-hour time as HH:MM, for example 09:00."},"timezone":{"type":"string","minLength":1,"maxLength":255,"description":"IANA timezone for the clock time, such as America/New_York. Use the timezone the user stated."}},"required":["kind","weekdays","time","timezone"],"additionalProperties":false,"description":"Post on one or more selected weekdays at the same local clock time."},{"type":"object","properties":{"kind":{"type":"string","const":"every_n_hours","description":"Repeat a fixed number of hours after the previous post."},"interval_hours":{"type":"integer","minimum":1,"maximum":168,"description":"How many hours between posts, from 1 to 168."}},"required":["kind","interval_hours"],"additionalProperties":false,"description":"Repeat every N hours, starting from now."},{"type":"object","properties":{"kind":{"type":"string","const":"once","description":"Post a single time, then stop."},"run_at":{"type":"string","format":"date-time","pattern":"^(?:(?:\\\\d\\\\d[2468][048]|\\\\d\\\\d[13579][26]|\\\\d\\\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\\\d|30)|(?:02)-(?:0[1-9]|1\\\\d|2[0-8])))T(?:(?:[01]\\\\d|2[0-3]):[0-5]\\\\d(?::[0-5]\\\\d(?:\\\\.\\\\d+)?)?(?:Z|([+-](?:[01]\\\\d|2[0-3]):[0-5]\\\\d)))$","description":"The future moment to post, RFC 3339 with offset, for example 2026-10-22T14:30:00-04:00."},"timezone":{"type":"string","minLength":1,"maxLength":255,"description":"IANA timezone for the clock time, such as America/New_York. Use the timezone the user stated."}},"required":["kind","run_at"],"additionalProperties":false,"description":"Post once at a set time, for example a check before a meeting; the Routine is done afterwards."}],"description":"When the Routine posts. daily and weekly use a clock time and timezone. every_n_hours repeats from now. once posts a single time at run_at."},"listener":{"description":"Present instead of schedule on an app listener. It can only be paused and enabled, and goes away when the Human revokes your access to the app.","type":"object","properties":{"app":{"type":"string","enum":["gmail","outlook","google_calendar","slack"],"description":"Connected app whose new events the Routine hands to proactive judgement."}},"required":["app"],"additionalProperties":false},"enabled":{"type":"boolean","description":"Whether the Routine will post on schedule."},"next_run_at":{"description":"UTC time of the next scheduled post. Absent while paused.","type":"string","minLength":1},"tracking_item_id":{"description":"Tracking Item this Routine serves, when it serves one.","type":"string"}},"required":["id","name","instruction","enabled"],"additionalProperties":false,"description":"One Routine in the current room."},"cli":{"usage":["teamhub routine create [flags]"],"arguments":[],"options":{"--name":{"description":"Routine name."},"--content":{"description":"Inline Markdown body; outside code, \\\\n, \\\\t and \\\\\\\\ are decoded."},"--file":{"description":"Read UTF-8 body from a file or - for stdin."},"--mention-actor-id":{"description":"Current Room Agent Actor ID, or self."},"--schedule":{"description":"Complete daily, weekly, every_n_hours or once schedule JSON."},"--schedule-file":{"description":"Read schedule JSON from a file or - for stdin."},"--daily":{"description":"Daily local time as HH:MM."},"--weekly":{"description":"Weekly local time as HH:MM."},"--weekday":{"description":"Selected weekday; repeat unique days.","repeatable":true},"--timezone":{"description":"Explicit IANA timezone for daily or weekly."},"--every-hours":{"description":"Repeat every 1-168 hours."},"--at":{"description":"Fire once at this RFC 3339 time (with offset); done afterwards."},"--tracking-item":{"description":"Tracking Item ID this Routine serves; requires --purpose."},"--purpose":{"description":"What this Routine checks or reminds for its Tracking Item."},"--json":{"description":"Return machine-readable JSON.","boolean":true},"--help":{"description":"Show this offline command reference.","boolean":true},"-h":{"description":"Show help.","boolean":true},"--schema":{"description":"Show offline input and output schemas.","boolean":true},"--operation-id":{"description":"Stable operation identity for recovery."}},"notes":[]}}
