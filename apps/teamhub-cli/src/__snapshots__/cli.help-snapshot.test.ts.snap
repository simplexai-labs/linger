  "knowledge search": {
    "help": "exit 0
teamhub knowledge search [flags]
Search every source of authorized knowledge; each result names its source kind.

Arguments:
  <query>

Options:
  --alternate <value>  Synonym, translation or related term searched beside the query; up to 6.
  --date-from <value>  YYYY-MM-DD ranking preference; other dates may appear.
  --date-to <value>  YYYY-MM-DD ranking preference; other dates may appear.
  --event-from <value>  YYYY-MM-DD ranking preference; other dates may appear.
  --event-to <value>  YYYY-MM-DD ranking preference; other dates may appear.
  --json  Return machine-readable JSON.
  --help  Show this offline command reference.
  -h  Show help.
  --schema  Show offline input and output schemas.
",
    "schema": "exit 0
{"command":["knowledge","search"],"description":"Search every source of authorized knowledge; each result names its source kind.","read_only":true,"input_schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"query":{"type":"string","minLength":1,"maxLength":10000,"description":"The distinctive phrase, entity, or term being asked about, keeping the current request's named project, person, or event. Do not add unrelated topics from earlier turns. When the question names a time, such as last weekend, in 2023, or last month, keep those words in the query and put the resolved dates in eventFrom/eventTo; leave them unset when the question names no time, even when the request carries a date."},"alternates":{"description":"Up to six synonyms, translations (Chinese and English) or related terms the evidence may use instead of the query's words. Each is searched separately beside the query; always pass some when the query is a single wording.","maxItems":6,"type":"array","items":{"type":"string","minLength":1,"maxLength":200,"description":"One synonym, translation or related term."}},"dateFrom":{"description":"Optional start of the period the question is about, such as when sources were recorded. It only ranks sources and facts from that period higher and never excludes other dates, so leave it unset unless the question names a period.","type":"string","format":"date","pattern":"^(?:(?:\\\\d\\\\d[2468][048]|\\\\d\\\\d[13579][26]|\\\\d\\\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\\\d|30)|(?:02)-(?:0[1-9]|1\\\\d|2[0-8])))$"},"dateTo":{"description":"Optional end of the period the question is about; pair with dateFrom. It only ranks results and never excludes other dates.","type":"string","format":"date","pattern":"^(?:(?:\\\\d\\\\d[2468][048]|\\\\d\\\\d[13579][26]|\\\\d\\\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\\\d|30)|(?:02)-(?:0[1-9]|1\\\\d|2[0-8])))$"},"eventFrom":{"description":"Inclusive start of when the asked event happened, such as 2026-04-01 for what the Human did last month. It ranks facts and sources from that period higher and never excludes others; it takes precedence over dateFrom/dateTo. Leave unset when the question does not ask about a time.","type":"string","format":"date","pattern":"^(?:(?:\\\\d\\\\d[2468][048]|\\\\d\\\\d[13579][26]|\\\\d\\\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\\\d|30)|(?:02)-(?:0[1-9]|1\\\\d|2[0-8])))$"},"eventTo":{"description":"Inclusive end of when the asked event happened; pair with eventFrom. Never a source-date filter.","type":"string","format":"date","pattern":"^(?:(?:\\\\d\\\\d[2468][048]|\\\\d\\\\d[13579][26]|\\\\d\\\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\\\d|30)|(?:02)-(?:0[1-9]|1\\\\d|2[0-8])))$"}},"required":["query"],"additionalProperties":false,"description":"Question for one search over every source of the Human's knowledge: Sessions, recordings, My pages, mail, Pocket Notes, the Profile, the published Wiki and Daily and Weekly reports."},"output_schema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"schemaVersion":{"type":"integer","const":2},"status":{"type":"string","enum":["grounded","partial","empty"],"description":"Candidate retrieval status, not the sufficiency of unread bodies."},"items":{"maxItems":20,"type":"array","items":{"type":"object","properties":{"citeAs":{"type":"string","pattern":"^S[1-9][0-9]*$","description":"Citation label assigned for this result."},"title":{"type":"string","minLength":1,"maxLength":512,"description":"Evidence title."},"excerpt":{"type":"string","minLength":1,"maxLength":600,"description":"Short preview of the matched original-source chunk."},"content":{"description":"Bounded matched chunk text for top-ranked candidates; several chunks are joined in document order with an ellipsis. A trailing ellipsis can indicate truncation. If a required fact is missing, read the returned directory section IDs; content presence does not mean the source is complete.","type":"string","maxLength":6000},"source":{"type":"object","properties":{"kind":{"type":"string","minLength":1,"maxLength":64,"description":"Where the source came from: room, recording, my_pages, mail, pocket_note, profile, wiki or period_summary."},"ref":{"type":"string","minLength":1,"maxLength":1024,"description":"Opaque source reference; not a user-facing label."},"label":{"description":"Source label.","type":"string","minLength":1,"maxLength":512}},"required":["kind","ref"],"additionalProperties":false,"description":"Evidence origin."},"representation":{"type":"string","enum":["source_excerpt","derived_summary","structured_fact"],"description":"Whether the evidence is source text, a summary, or a fact."},"facet":{"description":"Extensible semantic facet.","type":"string","minLength":1,"maxLength":128},"timeHint":{"description":"Time associated with this evidence when available.","type":"string","minLength":1,"maxLength":128},"metadata":{"description":"Small primitive metadata map.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"anyOf":[{"type":"string","maxLength":512,"description":"Metadata text value."},{"type":"number","description":"Metadata numeric value."},{"type":"boolean","description":"Metadata boolean value."},{"type":"null","description":"Metadata null value."}],"description":"Primitive evidence metadata value."}},"directory":{"description":"Available Markdown headings for a follow-up evidence read.","maxItems":64,"type":"array","items":{"type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":512,"description":"Markdown section title."},"level":{"type":"integer","minimum":1,"maximum":6,"description":"Markdown heading level."},"purpose":{"description":"Directory guidance, never evidence content.","type":"string","minLength":1,"maxLength":512},"sectionId":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9][a-z0-9_-]*$","description":"Stable section identifier within one evidence item."}},"required":["sectionId","title","level"],"additionalProperties":false,"description":"One available Markdown section for follow-up evidence reading."}},"evidenceId":{"type":"string","pattern":"^raw_[a-f0-9]{16}_[a-f0-9]{16}$","description":"Opaque raw_... candidate ID; pass it unchanged to teamhub knowledge read."}},"required":["evidenceId","citeAs","title","excerpt","source","representation"],"additionalProperties":false,"description":"One bounded piece of evidence for the Agent to synthesize."},"description":"Candidates ordered to match their S1...Sn labels; read relevant sections next."},"gaps":{"maxItems":20,"type":"array","items":{"type":"object","properties":{"code":{"type":"string","minLength":1,"maxLength":64,"description":"Extensible stable gap code."},"detail":{"description":"Optional safe detail about the evidence gap.","type":"string","minLength":1,"maxLength":512}},"required":["code"],"additionalProperties":false,"description":"One reason the retrieved evidence does not cover the query."},"description":"evidence_sections_not_read requires relevant reads before judging that information is missing."},"indexedAt":{"anyOf":[{"type":"string","format":"date-time","pattern":"^(?:(?:\\\\d\\\\d[2468][048]|\\\\d\\\\d[13579][26]|\\\\d\\\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\\\d|30)|(?:02)-(?:0[1-9]|1\\\\d|2[0-8])))T(?:(?:[01]\\\\d|2[0-3]):[0-5]\\\\d(?::[0-5]\\\\d(?:\\\\.\\\\d+)?)?(?:Z|([+-](?:[01]\\\\d|2[0-3]):[0-5]\\\\d)))$","description":"Newest source snapshot time."},{"type":"null","description":"No source snapshot is available."}],"description":"Time of the newest source snapshot queried, when available."},"facts":{"description":"Matched Session facts, ranked apart from items. They pinpoint details and event times; read the named source section when the answer depends on exact wording.","maxItems":30,"type":"array","items":{"type":"object","properties":{"text":{"type":"string","minLength":1,"maxLength":1000,"description":"The fact: what | When: ... | Involving: ... | why."},"factType":{"type":"string","enum":["world","assistant"],"description":"assistant marks what the agent did or suggested, not the Human."},"entities":{"description":"People, places and things the fact names.","maxItems":10,"type":"array","items":{"type":"string","minLength":1,"maxLength":80,"description":"Entity name."}},"occurredStart":{"description":"When the event began.","type":"string","format":"date","pattern":"^(?:(?:\\\\d\\\\d[2468][048]|\\\\d\\\\d[13579][26]|\\\\d\\\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\\\d|30)|(?:02)-(?:0[1-9]|1\\\\d|2[0-8])))$"},"occurredEnd":{"description":"When the event ended.","type":"string","format":"date","pattern":"^(?:(?:\\\\d\\\\d[2468][048]|\\\\d\\\\d[13579][26]|\\\\d\\\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\\\d|30)|(?:02)-(?:0[1-9]|1\\\\d|2[0-8])))$"},"mentionedAt":{"type":"string","minLength":1,"maxLength":64,"description":"When the source message said it."},"evidenceId":{"type":"string","pattern":"^raw_[a-f0-9]{16}_[a-f0-9]{16}$","description":"Opaque raw_... candidate ID; pass it unchanged to teamhub knowledge read."},"sectionId":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9][a-z0-9_-]*$","description":"Source section stating the fact; read it with evidenceId for the original wording."}},"required":["text","factType","mentionedAt","evidenceId","sectionId"],"additionalProperties":false,"description":"A fact extracted from a Room conversation, located in one source section."}},"requestId":{"description":"Optional query trace identifier.","type":"string","minLength":1,"maxLength":128}},"required":["schemaVersion","status","items","gaps","indexedAt"],"additionalProperties":false,"description":"Candidate routing hints; do not conclude information is insufficient before reading relevant available sections."},"cli":{"usage":["teamhub knowledge search [flags]"],"arguments":["<query>"],"options":{"--alternate":{"description":"Synonym, translation or related term searched beside the query; up to 6.","repeatable":true},"--date-from":{"description":"YYYY-MM-DD ranking preference; other dates may appear."},"--date-to":{"description":"YYYY-MM-DD ranking preference; other dates may appear."},"--event-from":{"description":"YYYY-MM-DD ranking preference; other dates may appear."},"--event-to":{"description":"YYYY-MM-DD ranking preference; other dates may appear."},"--json":{"description":"Return machine-readable JSON.","boolean":true},"--help":{"description":"Show this offline command reference.","boolean":true},"-h":{"description":"Show help.","boolean":true},"--schema":{"description":"Show offline input and output schemas.","boolean":true}},"notes":[]}}
