":1,"maximum":6,"description":"Markdown heading level."},"purpose":{"description":"Directory guidance, never evidence content.","type":"string","minLength":1,"maxLength":512},"sectionId":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9][a-z0-9_-]*$","description":"Stable section identifier within one evidence item."}},"required":["sectionId","title","level"],"additionalProperties":false,"description":"One available Markdown section for follow-up evidence reading."},"description":"Current Markdown section directory."},"sections":{"maxItems":8,"type":"array","items":{"type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":512,"description":"Markdown section title."},"level":{"type":"integer","minimum":1,"maximum":6,"description":"Markdown heading level."},"content":{"type":"string","maxLength":12000,"description":"Verbatim Markdown content for the requested section page."},"offset":{"type":"integer","minimum":0,"maximum":200000,"description":"Character offset of this page."},"truncated":{"type":"boolean","description":"Whether more content remains in this section."},"nextOffset":{"description":"Offset for the next page when the section is truncated.","type":"integer","minimum":1,"maximum":200000},"sectionId":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9][a-z0-9_-]*$","description":"Stable section identifier within one evidence item."}},"required":["sectionId","title","level","content","offset","truncated"],"additionalProperties":false,"description":"One requested Markdown section page."},"description":"Requested verbatim section pages."},"missingSections":{"maxItems":8,"type":"array","items":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-z0-9][a-z0-9_-]*$","description":"Stable section identifier within one evidence item."},"description":"Requested section IDs that are no longer available."},"complete":{"type":"boolean","description":"Whether all requested section pages were returned in full."}},"required":["schemaVersion","evidenceId","title","source","directory","sections","missingSections","complete"],"additionalProperties":false,"description":"Selected source evidence for the Agent to use in its answer."},"cli":{"usage":["teamhub knowledge read [flags]"],"arguments":["<evidence-id>"],"options":{"--section-id":{"description":"Exact sectionId from this source; 1-8 unique values.","repeatable":true},"--offset":{"description":"Continue one section at this exact offset; 0-200000."},"--json":{"description":"Return machine-readable JSON.","boolean":true},"--help":{"description":"Show this offline command reference.","boolean":true},"-h":{"description":"Show help.","boolean":true},"--schema":{"description":"Show offline input and output schemas.","boolean":true}},"notes":[]}}
