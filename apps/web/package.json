{
  "name": "@linger/web",
  "version": "0.0.0",
  "description": "Web: Vite React Product Client for TeamHub.",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/prepare-web-dev.mjs",
    "dev": "vite",
    "build": "pnpm run build:assets",
    "start": "node static-host.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 src e2e build-assets.mjs panel-url-preview.mjs postcss.config.mjs static-host.mjs vite.config.ts vite.mermaid-preview.config.ts vitest.config.ts",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run --config vitest.config.ts",
    "test:build": "vitest run --config vitest.build.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:e2e": "pnpm --dir ../.. test:e2e",
    "build:assets": "MIMALLOC_ARENA_EAGER_COMMIT=0 MIMALLOC_PURGE_DELAY=0 NODE_ENV=production vite build --mode production && MIMALLOC_ARENA_EAGER_COMMIT=0 MIMALLOC_PURGE_DELAY=0 NODE_ENV=production vite build --mode production --config vite.mermaid-preview.config.ts && node build-assets.mjs"
  },
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@emoji-mart/data": "1.2.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@hocuspocus/provider": "^4.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@mantine/core": "9.4.1",
    "@mantine/hooks": "9.4.1",
    "@noble/hashes": "2.2.0",
    "@open-file-viewer/core": "0.1.36",
    "@linger/document-files": "workspace:*",
    "@linger/document-model": "workspace:*",
    "@linger/knowledge-format": "workspace:*",
    "@linger/service-kit": "workspace:*",
    "@linger/wire-contracts": "workspace:*",
    "@tailwindcss/postcss": "4.3.1",
    "@tanstack/react-query": "5.101.3",
    "@tanstack/react-virtual": "3.14.9",
    "@tiptap/pm": "3.27.1",
    "ajv": "8.17.1",
    "ajv-draft-04": "1.0.0",
    "dompurify": "^3.4.17",
    "emojibase-data": "18.0.0",
    "jszip": "3.10.1",
    "livekit-client": "2.22.2",
    "lottie-web": "5.13.0",
    "lucide-react": "1.21.0",
    "mermaid": "^11.16.0",
    "motion": "^13.1.0",
    "negotiator": "1.0.0",
    "openapi-fetch": "0.17.0",
    "papaparse": "5.5.4",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "8.2.0",
    "remark-breaks": "4.0.0",
    "remark-cjk-friendly": "2.3.3",
    "remark-gfm": "^4.0.1",
    "sirv": "3.0.2",
    "tailwindcss": "4.3.1",
    "xlsx": "npm:@e965/xlsx@0.20.3",
    "y-indexeddb": "9.0.12",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "motion-utils": "^13.0.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.9"
  }
}
