{
  "name": "@linger/computer",
  "version": "0.51.0",
  "description": "Local Computer: resident Daemon, control CLI, and Runner Gateway transport.",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "bundle:archive": "node scripts/bundle.mjs --archive",
    "daemon": "cd local-daemon && go run ./cmd/linger-computer-daemon",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 ."
  },
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@playwright/mcp": "0.0.83"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "tar-stream": "3.1.7",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "yauzl": "3.4.0"
  }
}
