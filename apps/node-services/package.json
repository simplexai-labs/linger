{
  "name": "@linger/node-services",
  "version": "0.0.0",
  "description": "Node Services: Agent, Memory, LLM Wiki, Document Runtime and isolated Voice workers.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "scripts": {
    "build": "pnpm catalog:generate && pnpm clean && tsc -p tsconfig.build.json && install -m 0644 src/agent/observability/agent-log-file-worker.mjs dist/agent/observability/agent-log-file-worker.mjs",
    "catalog:generate": "node --import tsx scripts/generate-feature-catalog.ts",
    "catalog:check": "node --import tsx scripts/generate-feature-catalog.ts --check",
    "check": "pnpm exec concurrently --success all --names types,lint \"pnpm typecheck\" \"pnpm lint\" && pnpm test",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "node ../../scripts/with-local-env.mjs -- node --watch --watch-preserve-output --import tsx src/main.ts",
    "start": "node ../../scripts/with-local-env.mjs -- node --import tsx scripts/dev-supervisor.ts",
    "lint": "eslint --max-warnings=0 src tests scripts vitest.config.ts",
    "test": "vitest run",
    "typecheck": "pnpm catalog:check && tsc -p tsconfig.json --noEmit",
    "memory:daily": "node ../../scripts/with-local-env.mjs -- node --import tsx src/memory/daily-cli.ts run",
    "memory:daily:collect": "node ../../scripts/with-local-env.mjs -- node --import tsx src/memory/daily-cli.ts collect",
    "memory:daily:prompt": "node ../../scripts/with-local-env.mjs -- node --import tsx src/memory/daily-cli.ts prompt",
    "memory:daily:apply": "node ../../scripts/with-local-env.mjs -- node --import tsx src/memory/daily-cli.ts apply",
    "memory:weekly": "node ../../scripts/with-local-env.mjs -- node --import tsx src/memory/weekly-cli.ts run",
    "memory:weekly:collect": "node ../../scripts/with-local-env.mjs -- node --import tsx src/memory/weekly-cli.ts collect",
    "memory:weekly:prompt": "node ../../scripts/with-local-env.mjs -- node --import tsx src/memory/weekly-cli.ts prompt",
    "memory:weekly:apply": "node ../../scripts/with-local-env.mjs -- node --import tsx src/memory/weekly-cli.ts apply",
    "memory:user-memory:rollback": "node ../../scripts/with-local-env.mjs -- node --import tsx src/memory/user-memory-cli.ts",
    "memory:wiki-sync": "node ../../scripts/with-local-env.mjs -- node --import tsx src/memory/wiki-sync-cli.ts"
  },
  "dependencies": {
    "@hocuspocus/server": "^4.3.0",
    "@hono/node-server": "^1.19.14",
    "@napi-rs/canvas": "1.0.5",
    "@linger/document-files": "workspace:*",
    "@linger/document-model": "workspace:*",
    "@linger/knowledge-format": "workspace:*",
    "@linger/service-kit": "workspace:*",
    "@linger/voice-runtime": "workspace:*",
    "@linger/wire-contracts": "workspace:*",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "ajv": "8.17.1",
    "hono": "^4.12.31",
    "jsdom": "29.1.1",
    "jszip": "3.10.1",
    "mailparser": "3.10.0",
    "officeparser": "8.2.0",
    "openwiki": "0.4.3",
    "pdfjs-dist": "6.2.108",
    "postgres": "3.4.9",
    "proper-lockfile": "^4.1.2",
    "sharp": "0.35.3",
    "tesseract.js-core": "7.0.0",
    "undici": "8.10.0",
    "word-extractor": "1.0.4",
    "ws": "8.22.0",
    "xlsx": "npm:@e965/xlsx@0.20.3",
    "yaml": "2.9.0",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@linger/teamhub-cli": "workspace:*",
    "@types/jsdom": "^21.1.7",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.0.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "8.18.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
