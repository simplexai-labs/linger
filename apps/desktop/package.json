    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@types/node": "26.0.1",
    "@types/yazl": "3.3.1",
    "electron": "44.7.2",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
