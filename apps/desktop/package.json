{
  "name": "@linger/desktop",
  "version": "0.16.20",
  "private": true,
  "type": "module",
  "main": "dist/main/index.mjs",
  "scripts": {
    "build": "node build.mjs",
    "electron:install": "node node_modules/electron/install.js",
    "start": "node build.mjs && electron .",
    "test": "vitest run --config vitest.config.ts",
