{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The typecheck script checks the full project; emitting skips it.
    "noCheck": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
