{
  "name": "@linger/local-installation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "linger-production": "./dist/*.js",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/restore-byok.py', 'dist/restore-byok.py')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "test:byok-kit": "node --import tsx --test test/byok-restore.integration.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "lint": "eslint --max-warnings=0 src"
  },
  "dependencies": {
    "@linger/service-kit": "workspace:*",
    "tar": "7.5.22"
  }
}
