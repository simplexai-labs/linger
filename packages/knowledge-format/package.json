{
  "name": "@linger/knowledge-format",
  "version": "0.0.0",
  "description": "Knowledge Format: shared knowledge document format helpers.",
  "private": true,
  "type": "module",
  "files": [
    "dist/**/*.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "linger-production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./sections": {
      "types": "./src/sections.ts",
      "linger-production": "./dist/sections.js",
      "default": "./src/sections.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "dependencies": {
    "@linger/service-kit": "workspace:*",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
