{
  "name": "@linger/document-model",
  "version": "0.0.0",
  "description": "Document Model: pure, schema-versioned Room Document model shared by Web and Document Runtime.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "linger-production": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "dependencies": {
    "@linger/service-kit": "workspace:*",
    "@blocknote/core": "^0.51.4",
    "@noble/hashes": "2.2.0",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
