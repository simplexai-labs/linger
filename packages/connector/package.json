{
  "name": "@linger/connector",
  "version": "0.0.0",
  "description": "Connector: the seam between a chat surface and a Room, with Tencent iLink as the reference implementation.",
  "private": true,
  "type": "module",
  "files": [
    "dist/**/*.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "linger-production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./ilink": {
      "types": "./src/ilink.ts",
      "linger-production": "./dist/ilink.js",
      "default": "./src/ilink.ts"
    },
    "./text": {
      "types": "./src/text.ts",
      "linger-production": "./dist/text.js",
      "default": "./src/text.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
